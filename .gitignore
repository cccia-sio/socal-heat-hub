# Local build workspace — source data lives here and is NEVER committed.
# Rebuild the viewer with:  python3 scripts/build_diy_pca_viewer.py
scripts/*
!scripts/build_diy_pca_viewer.py
!scripts/build_lst_overlay.py
!scripts/build_userguide_pdf.sh
!scripts/build_data_overlays.py
!scripts/build_ucla_heat_tract_xwalk.py
!scripts/build_context_layers.py
!scripts/build_hero_figure.py
!scripts/build_coolzones.py
# index.html is generated; the page can't be rebuilt without its builder.
!scripts/build_landing_page.py
# The builder is tracked; the page it writes (main/hospitalizations.html) is
# not — see the ignore entry below.
!scripts/build_hospitalizations_viewer.py
data/*
!data/exposure
data/exposure/*
!data/exposure/processed
data/exposure/processed/*
!data/exposure/processed/landsat
!data/context
data/context/*
!data/context/sandag_landuse.pmtiles
!data/context/overlays

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Editor / OS cruft
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code local settings (also covered by the user's global gitignore, but a
# collaborator cloning without that config would otherwise commit it)
.claude/

# Internal review artifacts and scratch mockups — local only.
# The SDRCC comments PDF is a partner's private editorial feedback; it was
# tracked and (before the deploy allow-list) served publicly.
assets/*Comments*.pdf
_mockup_*.png

# Inlines the per-ZCTA heat-hospitalization estimates, which arrived by email
# with no license or right to redistribute (see DATA_LICENSE.md). Build locally.
main/hospitalizations.html

# Local slide decks (not deployed)
decks/

# Literature corpus / markdown RAG proxy — local only, never committed
literature/
